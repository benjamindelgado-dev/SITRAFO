  usecase "CU-REP-02\nConsultar registro de integraciones" as CU_REP_02 <<nuevo>>
  usecase "CU-REP-03\nEjecutar tareas diarias" as CU_REP_03 <<nuevo>>
  usecase "CU-REP-04\nConsultar la bandeja de pendientes" as CU_REP_04 <<nuevo>>
  usecase "CU-REP-05\nAvisar por correo el relevo entre roles" as CU_REP_05 <<nuevo>>
  usecase "CU-REP-06\nConsultar el seguimiento de un pedido\npor la API pública" as CU_REP_06 <<nuevo>>
  usecase "CU-REP-07\nEstimar el precio referencial\npor la API del cotizador" as CU_REP_07 <<nuevo>>
  usecase "CU-REP-08\nConsultar los materiales a reponer\npor la API de disponibilidad" as CU_REP_08 <<nuevo>>
}
ADM --> CU_REP_01
EJE --> CU_REP_01
