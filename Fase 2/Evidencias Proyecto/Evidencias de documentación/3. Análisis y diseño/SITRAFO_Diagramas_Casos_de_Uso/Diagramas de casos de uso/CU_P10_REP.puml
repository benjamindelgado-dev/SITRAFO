CRON --> CU_REP_03
CU_REP_03 --> UF
CU_REP_03 --> FER
UI --> CU_REP_04
SIS --> CU_REP_05
CU_REP_05 --> MAIL
CLI --> CU_REP_06
EXT --> CU_REP_06
