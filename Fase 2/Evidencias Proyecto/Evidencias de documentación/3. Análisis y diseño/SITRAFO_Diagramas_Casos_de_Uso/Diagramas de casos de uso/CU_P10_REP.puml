@startuml CU_P10_REP
title Paquete 10 — Reportes, integraciones, avisos y tareas programadas
!include _skin_cu.txt
actor "Administrador" as ADM
actor "Ejecutivo comercial" as EJE
actor "Jefe de producción" as JP
actor "Usuario interno" as UI
actor "Sistema" as SIS <<sistema>>
actor "Brevo" as MAIL <<sistema>>
actor "Programador de tareas" as CRON <<sistema>>
actor "mindicador.cl" as UF <<sistema>>
actor "Nager.Date" as FER <<sistema>>
actor "Cliente\n(con o sin sesión)" as CLI
actor "Sistema externo\n(clave de API)" as EXT <<sistema>>
