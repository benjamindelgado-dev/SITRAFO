  usecase "CU-REP-03\nEjecutar tareas diarias" as CU_REP_03 <<nuevo>>
}
ADM --> CU_REP_01
EJE --> CU_REP_01
JP --> CU_REP_01
ADM --> CU_REP_02
CRON --> CU_REP_03
CU_REP_03 --> UF
CU_REP_03 --> FER
@enduml
