# Copiar a .env y ajustar. NUNCA versionar .env
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
POSTGRES_DB=sitrafo
POSTGRES_USER=sitrafo
POSTGRES_PASSWORD=sitrafo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Servicios externos (Fase 2)
MINDICADOR_URL=https://mindicador.cl/api
# La API del Estado (apis.digital.gob.cl/fl) fue descontinuada y feriadito.cl
# aun no publica su API: se usa Nager.Date
FERIADOS_URL=https://date.nager.at/api/v3/PublicHolidays

# PayPal Sandbox: credenciales de una app creada en developer.paypal.com
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Correo transaccional (Brevo). Sin BREVO_API_KEY, en desarrollo los correos
# se muestran en la consola del contenedor en vez de enviarse.
BREVO_API_KEY=
# Remitente: debe estar verificado en Brevo (Senders, Domains & Dedicated IPs)
CORREO_REMITENTE=SITRAFO <tu_correo_verificado@gmail.com>
# Solo desarrollo: desvia TODOS los correos a esta direccion (dejar vacio en produccion)
CORREO_REDIRIGIR_A=
# Direccion publica del sitio, usada en los enlaces de los correos
SITIO_URL=http://localhost:8000
